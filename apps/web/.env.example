# apps/web/.env.example -- every VITE_* variable, no real value [09 §8.6].
# Only used by `vite dev`'s own local proxy (vite.config.ts) -- a real
# deployment serves this app same-origin behind the gateway, per
# 30-gateway.md's BFF shape, and needs neither variable.
VITE_BASE_URL=/
VITE_DEV_GATEWAY_URL=http://localhost:8000
